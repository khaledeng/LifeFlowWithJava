<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/cell_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_calendar_day_default"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="3dp">

        <!-- Day Number -->
        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Status Container -->
        <FrameLayout
            android:id="@+id/status_container"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp">

            <!-- Checkmark for 100% completion -->
            <ImageView
                android:id="@+id/iv_check_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge_check_green"
                android:padding="3dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="#39D353" />

            <!-- Cross mark for limit exceeded (100%+) -->
            <ImageView
                android:id="@+id/iv_cross_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge_cross_red"
                android:padding="3dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="#FF4D4D" />

            <!-- Percentage Text (Green for >= 50%, Orange for < 50%) -->
            <TextView
                android:id="@+id/tv_percentage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="70%"
                android:textColor="#39D353"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Neutral dot / dash for 0% -->
            <TextView
                android:id="@+id/tv_neutral_dash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="·"
                android:textColor="#3E3E48"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
