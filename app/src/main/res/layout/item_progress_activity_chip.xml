<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_container"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip_activity_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <!-- Activity Icon / Emoji -->
    <ImageView
        android:id="@+id/iv_activity_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_work"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tv_activity_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Activity Name -->
    <TextView
        android:id="@+id/tv_activity_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Work"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Target Badge -->
    <TextView
        android:id="@+id/tv_target_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_dark"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="8h"
        android:textColor="#A0A0B0"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
