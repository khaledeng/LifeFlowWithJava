<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_daily_item"
    android:layout_width="126dp"
    android:layout_height="184dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_rounded_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Day Name (e.g. خميس / Thursday) -->
    <TextView
        android:id="@+id/tv_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="خميس"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Date (e.g. 20 أغسطس / 20 Aug) -->
    <TextView
        android:id="@+id/tv_day_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="20 أغسطس"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Circular Badge Indicator -->
    <FrameLayout
        android:id="@+id/layout_circle_ring"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circle_ring_green">

        <!-- Center Text: "✓" or "70%" or "40%" -->
        <TextView
            android:id="@+id/tv_circle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✓"
            android:textColor="#39D353"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tracked vs Target (e.g. 7h 0m / 7h 0m) -->
    <TextView
        android:id="@+id/tv_tracked_vs_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="7h 0m / 7h 0m"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
