<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Percentage Badge on Left, Week Title on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Percentage Badge -->
        <TextView
            android:id="@+id/tv_week_card_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_active_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="75%"
            android:textColor="#39D353"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Week Title -->
        <TextView
            android:id="@+id/tv_week_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="هذا الأسبوع"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- 7 Day Columns Layout -->
    <LinearLayout
        android:id="@+id/layout_days_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Day 0 (Sat) -->
        <LinearLayout
            android:id="@+id/col_day_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="س"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_0"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_green">

                <TextView
                    android:id="@+id/tv_day_val_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#39D353"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 1 (Sun) -->
        <LinearLayout
            android:id="@+id/col_day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="أ"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_1"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_green">

                <TextView
                    android:id="@+id/tv_day_val_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#39D353"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 2 (Mon) -->
        <LinearLayout
            android:id="@+id/col_day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ا"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_2"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_orange">

                <TextView
                    android:id="@+id/tv_day_val_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="40%"
                    android:textColor="#FF8C42"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 3 (Tue) -->
        <LinearLayout
            android:id="@+id/col_day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ث"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_3"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_orange">

                <TextView
                    android:id="@+id/tv_day_val_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="40%"
                    android:textColor="#FF8C42"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 4 (Wed) -->
        <LinearLayout
            android:id="@+id/col_day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="أ"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_4"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_green">

                <TextView
                    android:id="@+id/tv_day_val_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="70%"
                    android:textColor="#39D353"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 5 (Thu) -->
        <LinearLayout
            android:id="@+id/col_day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="خ"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_5"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_green">

                <TextView
                    android:id="@+id/tv_day_val_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#39D353"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Day 6 (Fri) -->
        <LinearLayout
            android:id="@+id/col_day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_day_letter_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ج"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_day_ring_6"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_ring_dotted">

                <TextView
                    android:id="@+id/tv_day_val_6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="…"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
