<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Day Name, Date & Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_week_day_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saturday, Aug 15"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_week_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_active_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="✓ 100%"
            android:textColor="#39D353"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Middle Row: Tracked vs Target -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_week_tracked_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8h 15m"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_week_target_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="/"
            android:textColor="#5A5A62"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_week_target_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="8h 00m"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_week_percent_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="103%"
            android:textColor="#39D353"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_week_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="100"
        android:progressBackgroundTint="#26262E"
        android:progressTint="#39D353" />

</LinearLayout>
